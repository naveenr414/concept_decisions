# 1. Ignore every file inside the results directory (recursively)
results/**/*

# 2. But do NOT ignore the folders themselves 
# (This allows Git to see the sub-folders like 'basic' or 'ablations')
!results/**/

# 3. And do NOT ignore the .gitkeep files 
# (This is the only file inside those folders Git will track)
!results/**/.gitkeep

# --- CUB Data ---
data/cub/*
!data/cub/manual_concepts.txt
# --- Python / Environment ---
__pycache__/
*.py[cod]
*$py.class
.env
.venv
env/
venv/
ENV/
build/
dist/
*.egg-info/

# --- Jupyter Notebooks ---
.ipynb_checkpoints
# If you want to share the notebook but not the internal "output" state:
# (Optional) *.ipynb_checkpoints

# --- OS & IDEs ---
.DS_Store
.vscode/
.idea/
*.swp

# --- Large Model Files (Common in RL/ML) ---
*.pth
*.pkl
*.npy
*.joblib